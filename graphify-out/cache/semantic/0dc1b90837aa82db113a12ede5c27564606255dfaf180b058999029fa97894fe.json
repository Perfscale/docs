{"nodes": [{"id": "concepts_setup_teardown_before_after", "label": "before:/after: setup & teardown blocks", "file_type": "concept", "source_file": "en/concepts/setup-teardown.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A broken setup would make every iteration fail identically, so a failed before: step aborts the run before spawning VUs; teardown is best-effort and always attempted, including on Ctrl-C/SIGTERM"}, {"id": "concepts_setup_teardown_child_process", "label": "std/child_process@v1 (spawn sidecar process with readiness gate and restart policy)", "file_type": "concept", "source_file": "en/concepts/setup-teardown.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concepts_setup_teardown_kill_process", "label": "std/kill_process@v1 (graceful stop by registry name or pid)", "file_type": "concept", "source_file": "en/concepts/setup-teardown.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concepts_setup_teardown_allow_process_actions", "label": "allow_process_actions safety gate", "file_type": "concept", "source_file": "en/concepts/setup-teardown.mdx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process actions are fail-closed: a step list from an untrusted source cannot touch OS processes until the config explicitly opts in"}], "edges": [{"source": "concepts_setup_teardown_before_after", "target": "concepts_setup_teardown_child_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "en/concepts/setup-teardown.mdx", "source_location": null, "weight": 1.0}, {"source": "concepts_setup_teardown_before_after", "target": "concepts_setup_teardown_kill_process", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0,